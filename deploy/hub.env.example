# Environment for the vyshka-hub systemd unit; installed as /etc/vyshka/hub.env.
# Every line is optional. The unit's own defaults are a loopback listener on
# 8080 and a SQLite file under /var/lib/vyshka; a name set here overrides
# the unit. Keep the file readable by root only if it carries a Postgres
# password; the admin token does not belong here (the unit passes it as a
# credential from /etc/vyshka/admin-token).

# Where the hub listens. Keep it on loopback and put a TLS-terminating
# proxy in front (nginx-vyshka.conf.example).
#VYSHKA_ADDR=127.0.0.1:8080

# The system of record. Empty or unset means the SQLite file the unit names;
# a URL means Postgres (the repository README lists the accepted forms).
#DATABASE_URL=postgres://vyshka:secret@127.0.0.1:5432/vyshka?sslmode=disable

# Map tilesets for the panel's live map, one directory per world
# (panel/README.md, "Map tilesets"). Unset means the map lists players
# without imagery.
#VYSHKA_MAPS_DIR=/var/lib/vyshka/maps

# debug, info, warn, or error.
#VYSHKA_LOG_LEVEL=info

# false serves no panel: the Admin API only.
#VYSHKA_PANEL=true
